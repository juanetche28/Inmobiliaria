rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos del usuario que hace el pedido (su perfil en /users/{uid})
    function signedIn() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return signedIn() && me().role == 'admin'; }
    function hasPerm(p) { return isAdmin() || (signedIn() && me().permissions.get(p, false) == true); }

    // Propiedades: las ve cualquiera; escribir depende de los permisos
    match /properties/{id} {
      allow read: if true;
      allow create: if hasPerm('crearPropiedad');
      allow update: if hasPerm('editarPropiedad');
      allow delete: if hasPerm('eliminarPropiedad');
    }

    // Usuarios: cada uno lee su perfil; el admin lee y administra todos
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }
  }
}
